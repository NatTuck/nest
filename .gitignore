# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Test outputs
/notes/test-runs/

# W5 timeline dumps (`mix nest.timeline` reads these). The `notes/*.log`
# rule below does not cover the `*.jsonl` they write, and the timestamped
# run directories are throwaway observations, not source.
notes/usage-runs/

# Stray debug dumps in notes/ (raw API request logs). An ignore rule does
# not untrack files that are already committed, so the two that were
# committed before this rule (notes/token-issue.log, notes/max-tool-calls.log)
# were removed from tracking with `git rm --cached`. Merging that removal
# deletes them from a checkout; they stay recoverable from history at
# cfd19eb, e.g. `git show cfd19eb:notes/max-tool-calls.log`.
notes/*.log

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
nest-*.tar

# Ignore assets that are produced by build tools.
/priv/static/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/

# Database files
*.db
*.db-*

# JS test coverage output
/assets/coverage/
/assets/coverage-json/
*.coverdata
